# Copy to .env.local and fill in. Anything VITE_* is exposed to the browser —
# never put secrets here. Server-only secrets (Stripe secret key, Shopify Admin
# token, webhook secret) belong in a server runtime, not in this file.

# ---- Shopify Storefront (public) ----
# Storefront API is browser-safe and rate-limited. Public Storefront token only.
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Toggle to flip the app from local prototype data to live Shopify data.
# "true" or "1" enables it. Anything else uses the local prototype.
VITE_USE_SHOPIFY=false

# ---- AI Try-On (Gemini 2.5 Flash Image) ----
# Used by the Try-On modal to generate "wearing this product" images from
# a user-uploaded photo. Free-tier-accessible at https://aistudio.google.com.
# WARNING: this key is exposed to the browser. For production, proxy via
# your own server so the key isn't shipped to clients (rate-limit + abuse).
VITE_GEMINI_API_KEY=

# ---- Analytics ----
# Enables forwarding of track() events to a real provider. When unset events
# are still console-logged in dev for visibility.
VITE_ANALYTICS_ENABLED=false
VITE_PLAUSIBLE_DOMAIN=

# ---- Legacy/demo endpoints (until real backend lands) ----
VITE_NEWSLETTER_ENDPOINT=
VITE_CONTACT_ENDPOINT=
VITE_CHECKOUT_ENDPOINT=
